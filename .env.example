MONGODB_URI=
JWT_SECRET=
STRIPE_SECRET_KEY=
CLIENT_URL=http://localhost:5173
EMAIL_USER=
EMAIL_PASS=
PORT=5000
# ==== Firebase Admin (Service Account — NEVER commit the JSON) ====
# From Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Put each field into env vars (local .env + Vercel dashboard). Keep quotes around PRIVATE_KEY.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
